# Kopiere diese Datei nach .env und trage die Werte ein.
PORT=4000

# Anmelde-Benachrichtigung per Resend (optional).
# Ohne diese beiden Werte laeuft die App normal weiter, nur ohne Mail.
RESEND_API_KEY=
LOGIN_ALERT_TO=
# Eigene Domain erst nach Verifizierung bei Resend eintragen.
LOGIN_ALERT_FROM=Lernify <onboarding@resend.dev>
